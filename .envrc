# Machine-local settings contain names of pass entries, never credential values.
dotenv_if_exists .env.local

load_secret() {
  local target="$1" entry_var="$2" entry="${!2}" value
  if [[ -z "${!target}" && -n "$entry" ]]; then
    value="$(pass show "$entry" 2>/dev/null)" || return 1
    export "$target=${value%%$'\n'*}"
  fi
}
load_secret DATABASE_URL DATABASE_PASS_ENTRY
load_secret LLM_API_KEY LLM_KEY_PASS_ENTRY
load_secret EMBEDDING_API_KEY EMBEDDING_KEY_PASS_ENTRY
load_secret ELEVENLABS_API_KEY ELEVENLABS_PASS_ENTRY
load_secret OPENVIKING_API_KEY OPENVIKING_PASS_ENTRY
load_secret OPENAI_API_KEY OPENAI_PASS_ENTRY
