# Скопируйте в .env.local (ignored). Здесь только несекретные настройки.
# Credentials хранятся в pass; direnv загружает их из именованных записей.
# Не записывайте DATABASE_URL, API keys или пароли в этот файл.

HOST=127.0.0.1
# PORT выделяет bin/start через port-selector --name web; override допустим.
# PORT=4747
# APP_ORIGIN=http://127.0.0.1:4747

# OpenAI-совместимый LLM endpoint. Укажите модель своего шлюза.
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_MODEL=your-model
# LLM_KEY_PASS_ENTRY=your/pass/llm-key
# LLM_EXTRA_BODY={"reasoning":{"effort":"low"}}
# LLM_TEMPERATURE=off

# Собственная PostgreSQL база и pgvector (vector(1024)); роль без BYPASSRLS.
DATABASE_PASS_ENTRY=your/pass/database-url
# DATABASE_HOST=127.0.0.1
EMBEDDING_BASE_URL=http://127.0.0.1:4000/v1
EMBEDDING_MODEL=your-1024-dimension-embedding-model
# EMBEDDING_KEY_PASS_ENTRY=your/pass/embedding-key
# TIKA_URL=http://127.0.0.1:9998

# Распознавание речи.
STT_ENGINE=elevenlabs
SPEECH_LANGUAGE=ru
ELEVENLABS_PASS_ENTRY=your/pass/elevenlabs-key
# ELEVENLABS_STT_URL=wss://api.elevenlabs.io/v1/speech-to-text/realtime
# ELEVENLABS_STT_MODEL=scribe_v2_realtime
# ELEVENLABS_DOH_URL и ELEVENLABS_PROXY с credentials также загружайте из pass.
# WHISPER_MODEL=~/.cache/live-slides/models/ggml-large-v3-turbo.bin
# WHISPER_SERVER_BIN=whisper-server
# WHISPER_PROMPT=Термины вашего доклада.
# WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin
# WHISPER_MODEL_SHA1=4af2b29d7ec73d781377bfd1758ca957a807e941

# Личная память и дополнительный Corp-вход по умолчанию выключены.
# Username должен совпадать с suffix verified subject; local: аккаунты не подходят.
# CORP_VERIFY_URL=https://auth.example.org/auth/verify
# CORP_LOGIN_URL=https://auth.example.org/login
# CORP_OWNER_USER=presenter
# PERSONAL_SOURCE_SUBJECT=corp:presenter
# PERSONAL_SOURCE_NAME=Владелец
# OPENVIKING_URL=http://127.0.0.1:1933
# OPENVIKING_ACCOUNT=default
# OPENVIKING_USER=presenter
# OPENVIKING_PASS_ENTRY=your/pass/openviking-key
# OPENVIKING_ROOT_URI=viking://user/presenter/resources/materials
# SOURCE_METADATA_MARKER=source-metadata
# SOURCE_SCOPES=public-notes,research
# SOURCE_EXCLUDE=/digests/raw/
# SOURCES=off
# SITE_SEARCH_URL=https://example.org/search/
# SITE_SEARCH=off

# Публичная страница: только эти значения попадут в HTML.
# PUBLIC_SITE_URL=https://slides.example.org
# PUBLIC_AUTHOR_NAME=Автор сервиса
# PUBLIC_AUTHOR_URL=https://example.org
# PUBLIC_INTRO_VIDEO_URL=https://cdn.example.org/intro.mp4
# PUBLIC_INTRO_POSTER_URL=https://cdn.example.org/intro.jpg

# Release / CDN upload. Registry без тега; CDN настройки вашего провайдера.
# APP_IMAGE_REPOSITORY=registry.example.org/owner/live-slides
# PUBLIC_SITE_MEDIA_CDN_ENDPOINT=https://s3.example.org
# PUBLIC_SITE_MEDIA_CDN_REGION=your-region
# PUBLIC_SITE_MEDIA_CDN_BUCKET=your-public-bucket
# PUBLIC_SITE_MEDIA_CDN_URL=https://cdn.example.org
# PUBLIC_SITE_MEDIA_CDN_PREFIX=live-slides/media
# MEDIA_ACCESS_KEY_PASS_ENTRY=your/pass/media-access-key
# MEDIA_SECRET_KEY_PASS_ENTRY=your/pass/media-secret-key
# OPENAI_PASS_ENTRY=your/pass/openai-key
