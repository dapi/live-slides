# Machine-local, non-secret settings. Copy the lines you need to .env.local (ignored by Git).
# Secrets stay in pass; only the entry name goes here.

# --- Slide director model -------------------------------------------------------------------
# Default: Claude Haiku through the private LiteLLM gateway (subscription, no extra cost).
# LLM_BASE_URL=http://127.0.0.1:4000/v1
# LLM_MODEL=claude-haiku-subscription

# Quality profile: Claude Sonnet 5.5 through OpenRouter. In the 2026-10-06 comparison it was the
# only model both fast (about 2 s in a live run) and free of false "said" marks. Paid per token:
# roughly $8 per hour of speech. Use a key with a spending limit.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-sonnet-5.5
# LLM_KEY_PASS_ENTRY=<pass entry with an OpenRouter key>
# LLM_EXTRA_BODY={"reasoning":{"effort":"low"}}

# --- Speech recognition ---------------------------------------------------------------------
# STT_ENGINE=elevenlabs        # or: whisper (local, private)
# ELEVENLABS_PASS_ENTRY=live-slides/elevenlabs-api-key

# --- Knowledge base -------------------------------------------------------------------------
# SOURCE_SCOPES=materials,research
# SOURCES=off                  # slides from speech alone

# --- Projects and documents -----------------------------------------------------------------
# APP_ORIGIN=https://live-slides.pismenny.ru
# DATABASE_PASS_ENTRY=live-slides/database-url
# DATABASE_HOST=127.0.0.1    # local override when private DNS is unavailable
# Optional explicit /auth/corp sign-in; normal API requests use app-owned sessions only.
# CORP_VERIFY_URL=https://auth.example.org/auth/verify
# PERSONAL_SOURCE_SUBJECT=corp:owner
# EMBEDDING_MODEL=openviking-embedding
# EMBEDDING_BASE_URL=http://127.0.0.1:4000/v1
# TIKA_URL=http://127.0.0.1:9998
